# Beta Abierta (false = entrada libre sin contraseña; true = exigir clave institucional en AccessGate)
VITE_REQUIRE_ACCESS_KEY=false

# Interruptor de autenticación (false para Beta Abierta sin cuentas, true para lanzamiento masivo)
VITE_REQUIRE_LOGIN=false

# Credenciales públicas de Supabase (Project Settings > API)
VITE_SUPABASE_URL=TU_CLAVE_AQUI
VITE_SUPABASE_ANON_KEY=TU_CLAVE_AQUI
