# ============================================================
# PLANIFICA MAESTRO - Variables de Entorno de Ejemplo
# Copia este archivo a .env y define tus claves locales.
# NUNCA compartas ni subas tus claves al repositorio de Git.
# ============================================================

# Servidor Node.js
PORT=3001

# Proveedor Principal: Google Gemini (Texto, Visión, Grounding y TTS)
# https://aistudio.google.com/
GEMINI_API_KEY=

# Proveedor de Voz Principal: ElevenLabs (Multilingual natural)
# https://elevenlabs.io/
ELEVENLABS_API_KEY=

# Proveedor Secundario 1: Groq (Llama 3.3 70B ultrarrápido)
# https://console.groq.com/
GROQ_API_KEY=

# Proveedor Secundario 2: OpenRouter (Modelos abiertos de respaldo)
# https://openrouter.ai/
OPENROUTER_API_KEY=

# Proveedor de Búsqueda Web: Tavily Search API
# https://tavily.com/
TAVILY_API_KEY=

# Seguridad y Autenticación del Servidor (Beta Abierta: entrada libre sin claves)
ACCESO_ABIERTO=true
REQUIRE_ACCESS_KEY=false
APP_ACCESS_KEY=
OWNER_MASTER_KEY=

# Cuotas y Límites de Planificación Docente (Beta Abierta por dispositivo)
PLAN_LIMIT_MAX=25
PLAN_LIMIT_PERIOD=dia
PLAN_LIMIT_WARNING_THRESHOLD=0.8
RATE_LIMIT_DISPOSITIVO_DIARIO=25
RATE_LIMIT_IP_DIARIO=75
RATE_LIMIT_GLOBAL_DIARIO=500
